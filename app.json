{
  "expo": {
    "name": "Get It Out",
    "slug": "get-it-out",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "getitout",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.waynecparker.getitout",
      "adaptiveIcon": {
        "backgroundColor": "#10131A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10131A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Get It Out uses your microphone to record what you say, so it can transcribe it and respond."
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "./plugins/with-debuggable-preview"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f153fa08-ca0a-4825-a08f-1099c8e4965c"
      }
    },
    "owner": "mindsetmans-organization"
  }
}
