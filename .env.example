# Copy this file to .env and fill in the real values from your Supabase
# project's Settings → API page. Never commit .env — it's gitignored.
#
# These are EXPO_PUBLIC_ vars, which means they get bundled into the app
# and are visible to anyone who inspects it. That's expected for the
# Supabase URL and anon/public key — access control comes from Row Level
# Security, not from hiding these. Never put the service_role key here.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK keys (Project settings → API keys). Also public by
# design. Leave blank to keep subscriptions switched off in that build —
# the app then stays fully usable without a paywall (development only).
# For EAS builds, set these as EAS environment variables instead.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Public legal pages linked from the paywall (required by Apple).
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
